///
/// Fidelity tests for `Huffman`.
///
/// The three things that can silently corrupt every encoded game are checked
/// separately here:
///
///   1. the 256-entry `CODES` table survived transcription from
///      `src/main/scala/game/Huffman.scala`,
///   2. the table is a *complete* prefix code, so decoding is unambiguous and
///      total, and
///   3. `buildTree` produces a decoding tree that agrees with the table
///      symbol-for-symbol, and `write`/`read` round-trip every symbol.
///
/// Every literal marked "reference" below was produced by running the Scala
/// original on this machine, not by re-deriving it from the port:
///
///   * the table checksum is a fold over the 256 `Symbol(b("..."), n)` entries
///     parsed straight out of `game/Huffman.scala`;
///   * `REF_ALL_256` is `hex(w.toArray())` after
///     `for i <- 0 to 255 do Huffman.write(i, w)` on a fresh `BitOps.Writer`.
///
mod TestHuffman {
    use Huffman.HuffmanTable
    use Huffman.Node
    use Huffman.Symbol

    // ------------------------------------------------------------ reference data

    ///
    /// The 788 bytes the Scala `Huffman.write` emits for symbols 0..255 written
    /// back to back into one `BitOps.Writer`. Generated by running the Scala.
    ///
    def refAll256(): String =
        "26d2f6ee623de7ccf2c2db1f6d36bffdfdf38637a9527162bcf1f12f1787198871ac45c6d88dc6ec4771bd88f7"
      + "1bec47dc6fd88fd88ffe37ff8dfdc47f38dfe623fbe37fbe37f2e37f0e37faf1bf9b8dfc588fe9c47f471bfd1c"
      + "6fe3623faf88feaf1bfd3e37f3dc6fe3b8dfc7e23face37f3be37fa4e37f3fe37f3ac47f5bc47f53c47f51e37f"
      + "39f1bf9c78dfce588fea5c47f5a623fa878dfcfbe37f3e78dfcfae37f3e311fd6be37fa5f88feb5311fd6af1bf"
      + "9c2e37f38788fea4f8dfe94f11fd4978dfce0f8dfce0b8dfce038dfce0588fea09e37f381e23fa82311fd40788"
      + "fea0f71bfd2cdc6ff4abe23fa81bc6ff4b1623fa81188fea02e23fa80188fea05623fa91b88fea49e23fa92588"
      + "fea48e23fa92188fea45e23fa91588fea44e23fa91188fea43e23fa90d88fea41e23fa90588fea0de23fa83588"
      + "fea0ce23fa83188fea0ae23fa82988fea42e23fa90988fea0fe23fa83b88fea0e623fa90388fea40623fa81f88"
      + "fea07623fa81988fea0be23fa82d88fea04e23fa80988fea01e23fa80588fea00e23fa81788fea47e23fa91d88"
      + "fea4671bfd2bde37fa57fc6ff4a8b8dfe96ff1bfd2a4e37fa573c6ff4b6b8dfe96971bfd2d0e37fa575c6ff4a2"
      + "f8dfe94571bfd289e37fa511c6ff4a1f8dfe94371bfd285e37fa509c6ff4b5f8dfe96b71bfd2d5e37fa5a9c6ff"
      + "4adf8dfe95b71bfd295e37fa529c6ff4ad78dfe95a71bfd297e37fa52dc6ff4ac78dfe95871bfd293e37fa525c"
      + "6ff4bb78dfe97671bfd2ebe37fa5d5c6ff4b9f8dfe97371bfd291e37fa521c6ff4b8f8dfe97171bfd2e1e37fa5"
      + "c1c6ff4ba78dfe97471bfd28fe37fa51dc6ff4a0f8dfe94171bfd28de37fa519c6ff4b3f8dfe96771bfd281e37"
      + "fa501c6ff4b678dfe96c71bfd2e5e37fa5c9c6ff4ab78dfe95671bfd2b3e37fa565c6ff4aa78dfe95471bfd2ef"
      + "e37fa5ddc6ff4b2f8dfe96571bfd2c3e37fa585c6ff4aaf8dfe95571bfd2c9e37fa591c6ff4b1f8dfe96371bfd"
      + "2c1e37fa581c6ff4af38dfe953f1bfd2a6e37fa57dc6ff4a8f8dfe950f1bfd2a0e37fa5bdc6ff4a978dfe96ef1"
      + "bfd2dce37fa571c6ff4b6f8dfe968f1bfd2d3e37fa5760"

    ///
    /// `s = s * 1000003 + code; s = s * 1000003 + bits` folded over all 256
    /// entries in Java `long` arithmetic, computed from the *Scala source's*
    /// binary strings. A single wrong bit anywhere in the table moves it.
    ///
    def refChecksum(): Int64 = -3962335553600536364i64

    // ------------------------------------------------------------------ helpers

    /// `CODES(i).code`.
    def codeOf(cs: Vector[Symbol], i: Int32): Int32 =
        let Symbol.Symbol(c, _) = Vector.get(i, cs);
        c

    /// `CODES(i).bits`.
    def bitsOf(cs: Vector[Symbol], i: Int32): Int32 =
        let Symbol.Symbol(_, b) = Vector.get(i, cs);
        b

    /// Lowercase hex, one byte per two characters.
    def hexOf(a: Array[Int8, r]): String \ r =
        let digits = "0123456789abcdef";
        Array.foldLeft((acc, b) -> {
            let u = Bits.byteToUnsigned(b);
            let hi = String.charAt(Bits.ushr(u, 4), digits);
            let lo = String.charAt(Bits.band(u, 15), digits);
            "${acc}${hi}${lo}"
        }, "", a)

    /// `HuffmanTable`'s decoding tree.
    def rootOf(t: HuffmanTable): Node =
        let HuffmanTable.HuffmanTable(_, root) = t;
        root

    // -------------------------------------------------------------- table shape

    ///
    /// 256 entries, and every one of them is a well-formed non-negative code that
    /// fits in its declared width. `write` masks with `bitMask(bits)`, so a code
    /// wider than `bits` would be silently truncated rather than reported.
    ///
    @Test
    pub def testTableWellFormed(): Unit \ Assert = {
        let cs = Huffman.codes();
        Assert.assertEq(expected = 256, Vector.length(cs));
        def loop(i) =
            if (i > 255) ()
            else {
                let c = codeOf(cs, i);
                let b = bitsOf(cs, i);
                Assert.assertTrue(2 <= b and b <= 31);
                Assert.assertTrue(c >= 0);
                // c < 2^b, i.e. the code really is `b` bits wide.
                Assert.assertTrue(Bits.ushr(c, b) == 0);
                loop(i + 1)
            };
        loop(0)
    }

    ///
    /// The table is bit-identical to the one in `game/Huffman.scala`.
    ///
    @Test
    pub def testTableChecksum(): Unit \ Assert = {
        let cs = Huffman.codes();
        let sum = Vector.foldLeft((acc, s) -> {
            let Symbol.Symbol(c, b) = s;
            (acc * 1000003i64 + Bits.toLong(c)) * 1000003i64 + Bits.toLong(b)
        }, 0i64, cs);
        Assert.assertEq(expected = refChecksum(), sum);
        // Spot checks at both ends, so a checksum failure can be localised.
        Assert.assertEq(expected = Symbol.Symbol(0, 2), Vector.get(0, cs));
        Assert.assertEq(expected = Symbol.Symbol(4, 3), Vector.get(1, cs));
        Assert.assertEq(expected = Symbol.Symbol(1908396731, 31), Vector.get(255, cs))
    }

    // -------------------------------------------------------------- prefix code

    ///
    /// No code is a prefix of another. Checked over all 256*256 ordered pairs, so
    /// duplicate codes (`bi == bj` with equal codes) are caught too.
    ///
    @Test
    pub def testIsPrefixCode(): Unit \ Assert = {
        let cs = Huffman.codes();
        def inner(i, j) =
            if (j > 255) None
            else if (i == j) inner(i, j + 1)
            else {
                let bi = bitsOf(cs, i);
                let bj = bitsOf(cs, j);
                if (bi <= bj and Bits.ushr(codeOf(cs, j), bj - bi) == codeOf(cs, i))
                    Some((i, j))
                else
                    inner(i, j + 1)
            };
        def outer(i) =
            if (i > 255) None
            else match inner(i, 0) {
                case Some(p) => Some(p)
                case None    => outer(i + 1)
            };
        // `Some((i, j))` means CODES(i) is a prefix of CODES(j).
        Assert.assertEq(expected = None, outer(0))
    }

    ///
    /// The code is *complete*: its Kraft sum is exactly 1, so `buildTree` can
    /// never run past 31 bits without finding a leaf and no bit pattern is
    /// undecodable. `sum 2^(31-bits) == 2^31`, in `Int64` to avoid overflow.
    ///
    @Test
    pub def testKraftSumIsExactlyOne(): Unit \ Assert = {
        let cs = Huffman.codes();
        let sum = Vector.foldLeft((acc, s) -> {
            let Symbol.Symbol(_, b) = s;
            acc + Bits.shlL(1i64, 31 - b)
        }, 0i64, cs);
        Assert.assertEq(expected = 2147483648i64, sum)
    }

    // ---------------------------------------------------------- decoding tree

    ///
    /// Walking the tree along `CODES(i)`, most significant bit first, lands on
    /// `Leaf(i)` after exactly `bits` steps and passes through no leaf on the way.
    ///
    @Test
    pub def testTreeAgreesWithCodes(): Unit \ Assert = {
        let cs = Huffman.codes();
        let root = rootOf(Huffman.mkTable());
        // `None` = hit a leaf before consuming all `b` bits.
        def walk(node, c, b, k) =
            if (k == b) Some(node)
            else match node {
                case Node.Leaf(_)      => None
                case Node.Branch(z, o) =>
                    let bit = Bits.band(Bits.ushr(c, b - 1 - k), 1);
                    walk(if (bit == 0) z else o, c, b, k + 1)
            };
        def loop(i) =
            if (i > 255) ()
            else {
                Assert.assertEq(
                    expected = Some(Node.Leaf(i)),
                    walk(root, codeOf(cs, i), bitsOf(cs, i), 0));
                loop(i + 1)
            };
        loop(0)
    }

    ///
    /// The converse: enumerating every leaf of the tree recovers exactly the code
    /// table — 256 leaves, each symbol once, at the depth and along the path its
    /// entry names. Together with `testTreeAgreesWithCodes` this pins the tree
    /// down completely; on its own it also proves no interior node is unreachable
    /// and no symbol appears twice.
    ///
    @Test
    pub def testTreeLeavesAreExactlyTheTable(): Unit \ Assert = {
        let cs = Huffman.codes();
        let root = rootOf(Huffman.mkTable());
        def leaves(node, c, b, acc) = match node {
            case Node.Leaf(v)      => (v, c, b) :: acc
            case Node.Branch(z, o) =>
                leaves(z, Bits.shl(c, 1), b + 1,
                    leaves(o, Bits.bor(Bits.shl(c, 1), 1), b + 1, acc))
        };
        let found = leaves(root, 0, 0, Nil) |> List.sortBy(match (v, _, _) -> v);
        let expected =
            List.range(0, 256) |> List.map(i -> (i, codeOf(cs, i), bitsOf(cs, i)));
        Assert.assertEq(expected = 256, List.length(found));
        Assert.assertEq(expected = expected, found)
    }

    ///
    /// `buildTree` bottoms out exactly where a code ends, and nowhere else: the
    /// root is a branch, `0b00` is symbol 0, and `0b0` (a proper prefix of it) is
    /// not a leaf at all.
    ///
    @Test
    pub def testBuildTreeBoundaries(): Unit \ Assert = {
        let cs = Huffman.codes();
        Assert.assertEq(expected = Node.Leaf(0), Huffman.buildTree(cs, 0, 2));
        Assert.assertEq(expected = Node.Leaf(1), Huffman.buildTree(cs, 4, 3));
        Assert.assertEq(expected = Node.Leaf(255), Huffman.buildTree(cs, 1908396731, 31));
        def isBranch(n) = match n {
            case Node.Leaf(_)      => false
            case Node.Branch(_, _) => true
        };
        Assert.assertTrue(isBranch(Huffman.buildTree(cs, 0, 0)));
        Assert.assertTrue(isBranch(Huffman.buildTree(cs, 0, 1)));
        // 0b000 lies strictly below the leaf 0b00, so it must not exist as a code;
        // the subtree there is still a branch, because the code is complete.
        Assert.assertTrue(isBranch(Huffman.buildTree(cs, 1, 1)))
    }

    // ------------------------------------------------------------- write / read

    ///
    /// Symbols 0..255 written back to back give the exact byte stream the Scala
    /// produces, and reading them back yields 0..255 in order.
    ///
    @Test
    pub def testWriteAllMatchesScalaBytes(): Unit \ Assert = region rc {
        let t = Huffman.mkTable();
        let w = BitWriter.mk(rc);
        def write(v) = if (v <= 255) { Huffman.write(t, v, w); write(v + 1) } else ();
        write(0);
        let bytes = BitWriter.toArray(w);
        Assert.assertEq(expected = 788, Array.length(bytes));
        Assert.assertEq(expected = refAll256(), hexOf(bytes));

        let rd = BitReader.mk(rc, bytes);
        def read(v, acc) =
            if (v <= 255) read(v + 1, Huffman.read(t, rd) :: acc) else List.reverse(acc);
        Assert.assertEq(expected = List.range(0, 256), read(0, Nil))
    }

    ///
    /// Every symbol round-trips on its own, out of its own writer, and occupies
    /// exactly `ceil(bits / 8)` bytes.
    ///
    @Test
    pub def testRoundTripEachSymbolAlone(): Unit \ Assert = region rc {
        let t = Huffman.mkTable();
        let cs = Huffman.codes();
        def loop(v) =
            if (v > 255) ()
            else {
                let w = BitWriter.mk(rc);
                Huffman.write(t, v, w);
                let bytes = BitWriter.toArray(w);
                Assert.assertEq(expected = (bitsOf(cs, v) + 7) / 8, Array.length(bytes));
                let rd = BitReader.mk(rc, bytes);
                Assert.assertEq(expected = v, Huffman.read(t, rd));
                loop(v + 1)
            };
        loop(0)
    }

    ///
    /// The reverse direction on a boundary: writing the *descending* sequence
    /// 255..0 straddles every word boundary differently from the ascending one,
    /// and still round-trips.
    ///
    @Test
    pub def testRoundTripDescending(): Unit \ Assert = region rc {
        let t = Huffman.mkTable();
        let w = BitWriter.mk(rc);
        def write(v) = if (v >= 0) { Huffman.write(t, v, w); write(v - 1) } else ();
        write(255);
        let bytes = BitWriter.toArray(w);
        Assert.assertEq(expected = 788, Array.length(bytes));
        let rd = BitReader.mk(rc, bytes);
        def read(k, acc) =
            if (k < 256) read(k + 1, Huffman.read(t, rd) :: acc) else acc;
        Assert.assertEq(expected = List.range(0, 256), read(0, Nil))
    }

    ///
    /// An all-zero stream decodes to the most probable symbol repeatedly, because
    /// `CODES(0)` is `0b00`; an all-ones stream decodes to whatever the 1-branch
    /// spine reaches. Both are pure decoder behaviour with no matching encode, so
    /// they exercise `read` on input it did not produce itself.
    ///
    @Test
    pub def testReadDegenerateStreams(): Unit \ Assert = region rc {
        let t = Huffman.mkTable();
        let zeros = Array.repeat(rc, 8, 0i8);
        let rd0 = BitReader.mk(rc, zeros);
        def read0(k, acc) = if (k < 32) read0(k + 1, Huffman.read(t, rd0) :: acc) else acc;
        Assert.assertEq(expected = List.repeat(32, 0), read0(0, Nil));

        // 0b1111... : 1111 is not a code, 11111 is not either; the first code on
        // the all-ones spine is 0b1111111 = 127, symbol 22.
        let ones = Array.repeat(rc, 8, -1i8);
        let rd1 = BitReader.mk(rc, ones);
        Assert.assertEq(expected = 22, Huffman.read(t, rd1))
    }
}
